# Doxyfile for Velosha Helpdesk Documentation
# Configured according to PRD / Exam Specification

PROJECT_NAME           = "Velosha Helpdesk"
PROJECT_NUMBER         = "1.0.0"
PROJECT_BRIEF          = "Modul Layanan Bantuan dan Tiket Aduan Velosha"
OUTPUT_DIRECTORY       = docs/doxygen
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English
EXTENSION_MAPPING      = php=PHP

# Extraction Configuration
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_PRIV_VIRTUAL   = YES
EXTRACT_PACKAGE        = YES
EXTRACT_STATIC         = YES
CASE_SENSE_NAMES       = NO

# Input Files and Directories (Helpdesk Codebase)
INPUT                  = app/Services/Helpdesk \
                         app/Support/Helpdesk \
                         app/Enums \
                         app/Livewire/Helpdesk \
                         app/Policies/HelpdeskTicketPolicy.php \
                         app/Models/HelpdeskTicket.php \
                         app/Models/TicketResponse.php \
                         app/Models/SlaPolicy.php \
                         app/Models/ReplyTemplate.php \
                         app/Models/SatisfactionRating.php \
                         app/Models/TicketSuggestionFeedback.php
RECURSIVE              = YES
FILE_PATTERNS          = *.php
EXCLUDE_PATTERNS       = */tests/* */vendor/* */storage/* */public/*

# Source Browsing & Markdown
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

# Warning and Status Messages
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_LOGFILE           = docs/doxygen/warnings.txt

# Output Formats
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
GENERATE_LATEX         = NO
